# =============================================================================
# Render Environment Variables — fill these in after your first deploy
# =============================================================================
# These are NOT committed secrets — copy values from the Render dashboard.
# The render.yaml blueprint auto-wires most service-to-service URLs.
# You only need to manually set the values marked with  ← SET THIS

# --- Shared secrets (auto-generated by render.yaml, copy from dashboard) ---
JWT_SECRET=                          # ← auto-generated, copy from iotinel-auth service
INTERNAL_SERVICE_TOKEN=              # ← auto-generated, copy from iotinel-auth service

# --- Database (auto-wired by render.yaml fromDatabase) ---
DATABASE_URL=                        # ← auto-wired from iotinel-db

# --- Frontend URLs (set AFTER static sites are deployed) ---
# Go to each static site in Render dashboard, copy its URL, paste here.
ANALYST_UI_URL=https://iotinel-analyst-ui.onrender.com
SCIENTIST_UI_URL=https://iotinel-scientist-ui.onrender.com
ADMIN_UI_URL=https://iotinel-admin-ui.onrender.com

# --- Gateway URL (set on all frontend VITE_API_URL env vars) ---
VITE_API_URL=https://iotinel-gateway.onrender.com

# --- CORS: paste all frontend URLs comma-separated ---
# Set this on EVERY backend service's ALLOWED_ORIGINS env var in Render dashboard
ALLOWED_ORIGINS=https://iotinel-analyst-ui.onrender.com,https://iotinel-scientist-ui.onrender.com,https://iotinel-admin-ui.onrender.com

# --- Optional integrations ---
COHERE_API_KEY=                      # ← optional, for AI explanations in detection service
ELASTICSEARCH_URL=                   # ← optional, e.g. https://your-cluster.es.io:9243
REDIS_URL=                           # ← optional, Render Redis URL if you add one later

# --- MLflow (free tier uses ephemeral /tmp — runs are lost on restart) ---
MLFLOW_TRACKING_URI=/tmp/mlruns
MLOPS_API_BASE=http://localhost:8088
